{
  "$id": "https://example.com/polar-star-passport.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Polar Star Cognitive-Sensory Product Passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "short_passport",
    "cognitive_block",
    "sensory_block",
    "branding",
    "marketing",
    "production",
    "regulatory",
    "commerce",
    "validation_plan",
    "risks",
    "appendices",
    "sign_off_checklist"
  ],
  "properties": {
    "short_passport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "name",
        "name_variants",
        "audience",
        "pain",
        "uniqueness",
        "key_idea",
        "one_liner",
        "portion_g",
        "protein_per_portion_g",
        "calories_per_portion_kcal",
        "rrc_rub",
        "source_evidence_assumptions"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 10
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[А-Яа-яЁё0-9\\s\\-]+$"
        },
        "name_variants": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "logic"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 3,
                "maxLength": 40,
                "pattern": "^[А-Яа-яЁё0-9\\s\\-]+$"
              },
              "logic": {
                "type": "string",
                "minLength": 40
              }
            }
          }
        },
        "audience": {
          "type": "string",
          "minLength": 40
        },
        "pain": {
          "type": "string",
          "minLength": 80
        },
        "uniqueness": {
          "type": "string",
          "minLength": 100
        },
        "key_idea": {
          "type": "string",
          "minLength": 80
        },
        "one_liner": {
          "type": "string",
          "minLength": 40
        },
        "portion_g": {
          "type": ["number", "string"]
        },
        "protein_per_portion_g": {
          "type": ["number", "string"]
        },
        "calories_per_portion_kcal": {
          "type": ["number", "string"]
        },
        "rrc_rub": {
          "type": ["number", "string"]
        },
        "source_evidence_assumptions": {
          "type": "string",
          "minLength": 20
        }
      }
    },

    "cognitive_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pain_disruption",
        "consumption_change",
        "rituals",
        "narratives",
        "desired_model",
        "education"
      ],
      "properties": {
        "pain_disruption": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "core_problem",
            "why_existing_solutions_fail",
            "why_this_pain_can_create_a_new_category"
          ],
          "properties": {
            "core_problem": {
              "type": "string",
              "minLength": 150
            },
            "why_existing_solutions_fail": {
              "type": "string",
              "minLength": 150
            },
            "why_this_pain_can_create_a_new_category": {
              "type": "string",
              "minLength": 150
            }
          }
        },

        "consumption_change": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_market",
            "what_replaces",
            "new_monetizable_value",
            "why_people_will_pay"
          ],
          "properties": {
            "new_market": {
              "type": "string",
              "minLength": 100
            },
            "what_replaces": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 20
              }
            },
            "new_monetizable_value": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 30
              }
            },
            "why_people_will_pay": {
              "type": "string",
              "minLength": 120
            }
          }
        },

        "rituals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "behavior_change",
            "old_vs_new_rituals",
            "new_rituals",
            "usage_contexts"
          ],
          "properties": {
            "behavior_change": {
              "type": "string",
              "minLength": 120
            },
            "old_vs_new_rituals": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["old_ritual", "new_ritual"],
                "properties": {
                  "old_ritual": {
                    "type": "string",
                    "minLength": 15
                  },
                  "new_ritual": {
                    "type": "string",
                    "minLength": 15
                  }
                }
              }
            },
            "new_rituals": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 30
              }
            },
            "usage_contexts": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 30
              }
            }
          }
        },

        "narratives": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headlines",
            "landing_copy",
            "brand_story"
          ],
          "properties": {
            "headlines": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 40
              }
            },
            "landing_copy": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 90
              }
            },
            "brand_story": {
              "type": "string",
              "minLength": 180
            }
          }
        },

        "desired_model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "thoughts",
            "feelings",
            "behaviors"
          ],
          "properties": {
            "thoughts": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 12
              }
            },
            "feelings": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 12
              }
            },
            "behaviors": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 12
              }
            }
          }
        },

        "education": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channels",
            "mechanics",
            "low_budget_options",
            "scalable_options",
            "kpi"
          ],
          "properties": {
            "channels": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 10
              }
            },
            "mechanics": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 20
              }
            },
            "low_budget_options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 20
              }
            },
            "scalable_options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 20
              }
            },
            "kpi": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        },

        "source_evidence_assumptions": {
          "type": "string",
          "minLength": 20
        }
      }
    },

    "sensory_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual", "audio", "smell", "tactile", "taste"],
      "properties": {
        "visual": { "$ref": "#/definitions/sensory_modality" },
        "audio": { "$ref": "#/definitions/sensory_modality" },
        "smell": { "$ref": "#/definitions/sensory_modality" },
        "tactile": { "$ref": "#/definitions/sensory_modality" },
        "taste": { "$ref": "#/definitions/sensory_modality" },
        "source_evidence_assumptions": {
          "type": "string",
          "minLength": 20
        }
      }
    },

    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "story",
        "promise",
        "identity_effect",
        "context",
        "brand_core",
        "customer_journey",
        "growth_strategy",
        "source_evidence_assumptions"
      ],
      "properties": {
        "story": {
          "type": "string",
          "minLength": 150
        },
        "promise": {
          "type": "string",
          "minLength": 60
        },
        "identity_effect": {
          "type": "string",
          "minLength": 100
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["favorable", "unfavorable"],
          "properties": {
            "favorable": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 20
              }
            },
            "unfavorable": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "brand_core": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name_logic",
            "logo_idea",
            "slogan",
            "distinctive_assets"
          ],
          "properties": {
            "name_logic": {
              "type": "string",
              "minLength": 80
            },
            "logo_idea": {
              "type": "string",
              "minLength": 60
            },
            "slogan": {
              "type": "string",
              "minLength": 8
            },
            "distinctive_assets": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "customer_journey": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "customer_feeling",
              "next_trigger"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "enum": [
                  "awareness",
                  "interest",
                  "trial",
                  "repeat",
                  "loyalty",
                  "advocacy"
                ]
              },
              "customer_feeling": {
                "type": "string",
                "minLength": 20
              },
              "next_trigger": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "growth_strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["year_1", "year_3", "year_5", "year_10"],
          "properties": {
            "year_1": {
              "type": "string",
              "minLength": 60
            },
            "year_3": {
              "type": "string",
              "minLength": 60
            },
            "year_5": {
              "type": "string",
              "minLength": 60
            },
            "year_10": {
              "type": "string",
              "minLength": 60
            }
          }
        },
        "source_evidence_assumptions": {
          "type": "string",
          "minLength": 20
        }
      }
    },

    "marketing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments",
        "base_product",
        "line_extension",
        "pricing",
        "channels",
        "promotion",
        "source_evidence_assumptions"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segment",
              "need",
              "purchase_trigger",
              "why_they_buy",
              "acquisition_channel"
            ],
            "properties": {
              "segment": {
                "type": "string",
                "minLength": 10
              },
              "need": {
                "type": "string",
                "minLength": 30
              },
              "purchase_trigger": {
                "type": "string",
                "minLength": 20
              },
              "why_they_buy": {
                "type": "string",
                "minLength": 30
              },
              "acquisition_channel": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        },
        "base_product": {
          "type": "string",
          "minLength": 80
        },
        "line_extension": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 20
          }
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_rrc_rub",
            "pricing_logic",
            "models"
          ],
          "properties": {
            "base_rrc_rub": {
              "type": ["number", "string"]
            },
            "pricing_logic": {
              "type": "string",
              "minLength": 80
            },
            "models": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "channels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "growth", "scale"],
          "properties": {
            "start": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 10
              }
            },
            "growth": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 10
              }
            },
            "scale": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low_budget", "testable", "scalable"],
          "properties": {
            "low_budget": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 20
              }
            },
            "testable": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 20
              }
            },
            "scalable": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "source_evidence_assumptions": {
          "type": "string",
          "minLength": 20
        }
      }
    },

    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technology_process_steps",
        "qc_checkpoints",
        "shelf_life_days",
        "shelf_life_method",
        "packaging_spec",
        "microbiology_limits",
        "production_constraints",
        "source_evidence_assumptions"
      ],
      "properties": {
        "technology_process_steps": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step", "detail", "ccp"],
            "properties": {
              "step": {
                "type": "string",
                "minLength": 10
              },
              "detail": {
                "type": "string",
                "minLength": 25
              },
              "ccp": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        },
        "qc_checkpoints": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 15
          }
        },
        "shelf_life_days": {
          "type": ["number", "string"]
        },
        "shelf_life_method": {
          "type": "string",
          "minLength": 40
        },
        "packaging_spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "material",
            "o2_transmission_rate",
            "moisture_transmission",
            "seal_strength"
          ],
          "properties": {
            "material": {
              "type": "string",
              "minLength": 10
            },
            "o2_transmission_rate": {
              "type": "string",
              "minLength": 5
            },
            "moisture_transmission": {
              "type": "string",
              "minLength": 5
            },
            "seal_strength": {
              "type": "string",
              "minLength": 5
            }
          }
        },
        "microbiology_limits": {
          "type": "object"
        },
        "production_constraints": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 20
          }
        },
        "source_evidence_assumptions": {
          "type": "string",
          "minLength": 20
        }
      }
    },

    "regulatory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_claims",
        "forbidden_claims",
        "labeling_requirements",
        "legal_notes",
        "source_evidence_assumptions"
      ],
      "properties": {
        "allowed_claims": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "forbidden_claims": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "labeling_requirements": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "legal_notes": {
          "type": "string",
          "minLength": 40
        },
        "source_evidence_assumptions": {
          "type": "string",
          "minLength": 20
        }
      }
    },

    "commerce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_economics",
        "pricing_models",
        "cac_target_rub",
        "ltv_target_rub",
        "break_even_volume_months",
        "source_evidence_assumptions"
      ],
      "properties": {
        "unit_economics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_material_cost_rub_per_unit",
            "packaging_cost_rub_per_unit",
            "production_cost_rub_per_unit",
            "logistics_rub_per_unit",
            "opex_alloc_rub_per_unit",
            "cost_per_unit_rub",
            "rrc_assumed_rub",
            "gross_margin_percent",
            "notes"
          ],
          "properties": {
            "raw_material_cost_rub_per_unit": { "type": ["number", "string"] },
            "packaging_cost_rub_per_unit": { "type": ["number", "string"] },
            "production_cost_rub_per_unit": { "type": ["number", "string"] },
            "logistics_rub_per_unit": { "type": ["number", "string"] },
            "opex_alloc_rub_per_unit": { "type": ["number", "string"] },
            "cost_per_unit_rub": { "type": ["number", "string"] },
            "rrc_assumed_rub": { "type": ["number", "string"] },
            "gross_margin_percent": { "type": ["number", "string"] },
            "notes": {
              "type": "string",
              "minLength": 30
            }
          }
        },
        "pricing_models": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 15
          }
        },
        "cac_target_rub": { "type": ["number", "string"] },
        "ltv_target_rub": { "type": ["number", "string"] },
        "break_even_volume_months": { "type": ["number", "string"] },
        "source_evidence_assumptions": {
          "type": "string",
          "minLength": 20
        }
      }
    },

    "validation_plan": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "hypothesis",
          "method",
          "kpi",
          "threshold",
          "duration_days",
          "budget_rub"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 10
          },
          "hypothesis": {
            "type": "string",
            "minLength": 30
          },
          "method": {
            "type": "string",
            "minLength": 25
          },
          "kpi": {
            "type": "string",
            "minLength": 10
          },
          "threshold": {
            "type": "string",
            "minLength": 8
          },
          "duration_days": {
            "type": ["number", "string"]
          },
          "budget_rub": {
            "type": ["number", "string"]
          }
        }
      }
    },

    "risks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk",
          "category",
          "probability",
          "impact",
          "mitigation"
        ],
        "properties": {
          "risk": {
            "type": "string",
            "minLength": 20
          },
          "category": {
            "type": "string",
            "enum": [
              "product",
              "technology",
              "behavioral",
              "marketing",
              "pricing",
              "operational",
              "regulatory"
            ]
          },
          "probability": {
            "type": "string",
            "minLength": 3
          },
          "impact": {
            "type": "string",
            "minLength": 3
          },
          "mitigation": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },

    "appendices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensory_protocol_template",
        "unit_economics_template",
        "qa_checklist_template"
      ],
      "properties": {
        "sensory_protocol_template": {
          "type": "object"
        },
        "product_card_example": {
          "type": ["object", "null"]
        },
        "unit_economics_template": {
          "type": "string",
          "minLength": 20
        },
        "qa_checklist_template": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },

    "sign_off_checklist": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "status", "comments"],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 10
          },
          "status": {
            "type": "string",
            "enum": ["Yes", "No", "N/A"]
          },
          "comments": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    }
  },

  "definitions": {
    "sensory_modality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desired_experience",
        "memory_marker",
        "brand_role",
